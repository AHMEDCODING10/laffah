# Root .gitignore for Laffah Platform (Pixelmind)

# Secrets & Environment
.env
.env.*
!.env.example
!.env.production.example
*.key
*.jks
*.p12
*.keystore
firebase-credentials.json

# Dependencies & Build artifacts
node_modules/
vendor/
build/
.dart_tool/
.pub-cache/
.flutter-plugins
.flutter-plugins-dependencies

# Logs & Cache
*.log
storage/logs/*
storage/framework/cache/*
storage/framework/sessions/*
storage/framework/views/*
.phpunit.result.cache

# OS & IDE
.DS_Store
Thumbs.db
.idea/
.vscode/
*.iml
