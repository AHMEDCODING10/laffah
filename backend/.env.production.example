# ==============================================================================
# Laffah Production Environment Configuration Template (.env)
# ==============================================================================

APP_NAME="لَفَّة"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_TIMEZONE=Asia/Aden
APP_URL=https://your-production-domain.com

APP_LOCALE=ar
APP_FALLBACK_LOCALE=ar
APP_FAKER_LOCALE=ar_SA

# Database (MySQL 8.0 / MariaDB on Cloud / Railway / Render)
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=laffah_db
DB_USERNAME=laffah_user
DB_PASSWORD=your_strong_database_password

# Session & Cache (Use Redis for High Performance, or database / file)
SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

CACHE_STORE=database
CACHE_PREFIX=laffah_cache_

# Queues (Database or Redis)
QUEUE_CONNECTION=database

# Real-Time Event Broadcasting (Laravel Reverb / Pusher)
BROADCAST_CONNECTION=reverb

REVERB_APP_ID=laffah_app_id
REVERB_APP_KEY=laffah_app_key_secret_2026
REVERB_APP_SECRET=laffah_app_secret_hash_2026
REVERB_HOST=0.0.0.0
REVERB_PORT=8080
REVERB_SCHEME=https

# JWT Auth Secret
JWT_SECRET=your_generated_jwt_secret_key
JWT_TTL=525600

# Firebase Cloud Messaging (FCM Service Account Credentials)
FIREBASE_CREDENTIALS=/var/www/html/storage/app/firebase-credentials.json

# Mail Configuration
MAIL_MAILER=smtp
MAIL_HOST=smtp.mailgun.org
MAIL_PORT=587
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_ENCRYPTION=tls
MAIL_FROM_ADDRESS="no-reply@laffah.com"
MAIL_FROM_NAME="لَفَّة Laffah"

# Cloud Startup Flags
ENABLE_REVERB=true
ENABLE_QUEUE=true
